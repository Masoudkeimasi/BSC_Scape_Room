# Optional: anonymous play needs none of these. Never prefix secrets with NEXT_PUBLIC_.
# Local single-process instructor access (use a strong unique password):
INSTRUCTOR_PASSWORD=
SESSION_SECRET=
# Optional authenticated assessment. Apply supabase/schema.sql before enabling.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local demo data: defaults to .data in the project directory.
# For ephemeral hosts use /tmp/persepolis-demo (not durable across deployments).
DATA_DIR=
